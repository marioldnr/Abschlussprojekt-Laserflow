# LaserFlow – lokale Einstellungen (Vorlage)
#
# So geht's: Diese Datei kopieren, die Kopie ".env" nennen (im Repo-Ordner, neben CLAUDE.md)
# und die Werte eintragen. Die .env enthält das App-Passwort und gehört NIE ins Repo.
# Ohne .env (oder ohne Passwort) erscheinen alle E-Mails nur im Terminal.

# Gmail-Adresse des Teams (Absender aller LaserFlow-Mails)
LASERFLOW_SMTP_USER=eure-adresse@gmail.com

# App-Passwort aus dem Google-Konto (16 Zeichen, Leerzeichen sind egal).
# NICHT das normale Gmail-Passwort.
LASERFLOW_SMTP_PASSWORD=

# Optional: echten Versand abschalten, obwohl Zugangsdaten eingetragen sind
# LASERFLOW_MAIL_MODE=console
